---
import { SITE_NAME } from '~/config';
const ano = new Date().getFullYear();
---
<footer class="mt-24 border-t border-slate-800/80">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-slate-400 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <div>
      <p class="text-slate-300">Análise de sites feita no Brasil.</p>
      <p class="mt-1 text-xs">© {ano} {SITE_NAME}. Todos os direitos reservados.</p>
    </div>
    <nav class="flex flex-wrap gap-4">
      <a href="/precos" class="hover:text-white">Preços</a>
      <a href="/cliente/login" class="hover:text-white">Entrar</a>
      <a href="https://github.com/danpqdan" rel="noopener" class="hover:text-white">GitHub</a>
    </nav>
  </div>
</footer>
