---
/**
 * CommandPalette — Cmd+K (ou Ctrl+K) abre busca rápida.
 *
 * Comandos sao definidos como dataset estatico abaixo + secao
 * "Atalhos" pre-listados. Filtragem por digitacao e' substring case-
 * insensitive em label + keywords. Setas movem highlight, Enter
 * navega, Esc fecha.
 *
 * Acessibilidade:
 *   - role="dialog" aria-modal="true" aria-label
 *   - foco vai pro input ao abrir, retorna pro elemento que abriu ao fechar
 *   - lista com role="listbox", items com role="option" + aria-selected
 *
 * Drop-in: <CommandPalette /> uma vez no Base.astro. Atalho global de
 * teclado e' adicionado pelo proprio script.
 */
interface Comando {
  id: string;
  label: string;
  href: string;
  keywords: string;
  group: 'navegar' | 'cliente' | 'externo';
  icon: string;
}

const comandos: Comando[] = [
  // Navegacao publica
  { id: 'home',       label: 'Início',                href: '/',                          keywords: 'home início landing', group: 'navegar', icon: '🏠' },
  { id: 'recursos',   label: 'Recursos',              href: '/recursos',                  keywords: 'features recursos', group: 'navegar', icon: '✨' },
  { id: 'precos',     label: 'Preços',                href: '/precos',                    keywords: 'preços planos pricing pago', group: 'navegar', icon: '💎' },
  { id: 'integracoes',label: 'Integrações',           href: '/integracoes',               keywords: 'sdk install npm html react next astro wordpress shopify rest', group: 'navegar', icon: '🔌' },
  { id: 'seguranca',  label: 'Segurança & LGPD',      href: '/seguranca',                 keywords: 'segurança lgpd privacidade jwt bcrypt', group: 'navegar', icon: '🔒' },
  { id: 'sobre',      label: 'Sobre',                 href: '/sobre',                     keywords: 'sobre about empresa', group: 'navegar', icon: '🤝' },

  // Cliente (logado)
  { id: 'painel',         label: 'Ir pro painel',          href: '/cliente/painel',         keywords: 'painel dashboard home', group: 'cliente', icon: '📊' },
  { id: 'configuracoes',  label: 'Configurações',          href: '/cliente/configuracoes',  keywords: 'config settings keys plano cardinalidade email senha', group: 'cliente', icon: '⚙️' },
  { id: 'onboarding',     label: 'Configurar SDK',         href: '/cliente/onboarding',     keywords: 'onboarding sdk install configurar key', group: 'cliente', icon: '🚀' },
  { id: 'exportar',       label: 'Exportar dados (CSV)',   href: '/cliente/exportar',       keywords: 'exportar csv backup download', group: 'cliente', icon: '📥' },
  { id: 'cadastro',       label: 'Criar conta',            href: '/cliente/cadastro',       keywords: 'cadastro signup criar conta novo', group: 'cliente', icon: '✍️' },
  { id: 'login',          label: 'Entrar',                 href: '/cliente/login',          keywords: 'login entrar acesso', group: 'cliente', icon: '🔑' },

  // Atalhos externos
  { id: 'metricas',  label: 'Abrir Grafana',  href: 'https://app.dsplayground.com.br/cliente/metricas',     keywords: 'grafana metricas analytics dashboard externo', group: 'externo', icon: '📈' },
  { id: 'github',    label: 'Repositório GitHub',          href: 'https://github.com/danpqdan/portifolio', keywords: 'github código source', group: 'externo', icon: '💻' },
  { id: 'sdk-repo',  label: 'SDK no GitHub',               href: 'https://github.com/danpqdan/dsplayground-analytics-sdk', keywords: 'sdk github npm pacote', group: 'externo', icon: '📦' },
];

const groupLabels = {
  navegar: 'Navegar',
  cliente: 'Área do cliente',
  externo: 'Externo',
} as const;
---
<!-- Backdrop + dialog. Tudo hidden por default; JS abre via Cmd+K. -->
<div
  id="cmdk-backdrop"
  class="hidden fixed inset-0 z-40 bg-slate-950/80 backdrop-blur-sm"
  aria-hidden="true"
></div>

<div
  id="cmdk-dialog"
  class="hidden fixed inset-x-0 top-[15vh] z-50 mx-auto max-w-xl rounded-xl border border-slate-700 bg-slate-900 shadow-elev-3"
  role="dialog"
  aria-modal="true"
  aria-label="Busca rápida"
  aria-labelledby="cmdk-title"
>
  <div class="border-b border-slate-800 px-4 py-3">
    <label for="cmdk-input" id="cmdk-title" class="sr-only">Buscar página ou comando</label>
    <div class="flex items-center gap-3">
      <span class="text-slate-500" aria-hidden="true">⌕</span>
      <input
        id="cmdk-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="Onde você quer ir? (digite pra filtrar)"
        class="flex-1 bg-transparent text-sm text-white placeholder:text-slate-500 focus:outline-none"
      />
      <kbd class="hidden rounded border border-slate-700 bg-slate-800 px-1.5 py-0.5 text-[10px] font-medium text-slate-400 sm:inline-block">Esc</kbd>
    </div>
  </div>

  <ul
    id="cmdk-list"
    role="listbox"
    aria-label="Resultados"
    class="max-h-[50vh] overflow-y-auto p-2"
  >
    {(['navegar', 'cliente', 'externo'] as const).map((group) => {
      const items = comandos.filter((c) => c.group === group);
      return (
        <li class="cmdk-group" data-group={group}>
          <h3 class="px-3 py-2 text-[10px] font-semibold uppercase tracking-wide text-slate-500">{groupLabels[group]}</h3>
          <ul>
            {items.map((c) => (
              <li
                role="option"
                tabindex="-1"
                aria-selected="false"
                data-cmd-id={c.id}
                data-cmd-href={c.href}
                data-cmd-label={c.label}
                data-cmd-keywords={c.keywords}
                class="cmdk-item flex cursor-pointer items-center gap-3 rounded-md px-3 py-2 text-sm text-slate-200 transition aria-selected:bg-brand-500/15 aria-selected:text-white hover:bg-slate-800"
              >
                <span aria-hidden="true">{c.icon}</span>
                <span class="flex-1">{c.label}</span>
                <span class="text-xs text-slate-500">{c.href.startsWith('http') ? 'externo ↗' : c.href}</span>
              </li>
            ))}
          </ul>
        </li>
      );
    })}

    <li id="cmdk-empty" class="hidden px-3 py-8 text-center text-sm text-slate-400">
      Nada encontrado. Tenta outra palavra.
    </li>
  </ul>

  <footer class="flex items-center justify-between border-t border-slate-800 px-4 py-2 text-[10px] text-slate-500">
    <div class="flex items-center gap-3">
      <span><kbd class="rounded border border-slate-700 bg-slate-800 px-1 py-0.5 font-medium">↑↓</kbd> navegar</span>
      <span><kbd class="rounded border border-slate-700 bg-slate-800 px-1 py-0.5 font-medium">↵</kbd> abrir</span>
    </div>
    <span><kbd class="rounded border border-slate-700 bg-slate-800 px-1 py-0.5 font-medium">⌘K</kbd> / <kbd class="rounded border border-slate-700 bg-slate-800 px-1 py-0.5 font-medium">Ctrl K</kbd></span>
  </footer>
</div>

<script>
  const backdrop = document.getElementById('cmdk-backdrop');
  const dialog = document.getElementById('cmdk-dialog');
  const input = document.getElementById('cmdk-input') as HTMLInputElement | null;
  const list = document.getElementById('cmdk-list');
  const emptyEl = document.getElementById('cmdk-empty');

  if (!backdrop || !dialog || !input || !list || !emptyEl) {
    // Componente nao montado nesta page — atalho fica no-op silencioso.
  } else {
    const items = Array.from(list.querySelectorAll<HTMLElement>('.cmdk-item'));
    const groups = Array.from(list.querySelectorAll<HTMLElement>('.cmdk-group'));
    let openerEl: HTMLElement | null = null;
    let activeIdx = 0;

    function visibleItems(): HTMLElement[] {
      return items.filter((it) => !it.hidden);
    }

    function setActive(idx: number) {
      const vis = visibleItems();
      if (vis.length === 0) return;
      activeIdx = (idx + vis.length) % vis.length;
      vis.forEach((it, i) => {
        const sel = i === activeIdx;
        it.setAttribute('aria-selected', String(sel));
        if (sel) it.scrollIntoView({ block: 'nearest' });
      });
    }

    function abrir() {
      openerEl = (document.activeElement as HTMLElement) ?? null;
      backdrop!.classList.remove('hidden');
      dialog!.classList.remove('hidden');
      input!.value = '';
      filtrar('');
      setActive(0);
      // Foco no input apos paint
      requestAnimationFrame(() => input!.focus());
    }

    function fechar() {
      backdrop!.classList.add('hidden');
      dialog!.classList.add('hidden');
      openerEl?.focus?.();
    }

    function filtrar(query: string) {
      const q = query.trim().toLowerCase();
      let anyVisible = false;
      items.forEach((it) => {
        const label = (it.dataset.cmdLabel ?? '').toLowerCase();
        const keys = (it.dataset.cmdKeywords ?? '').toLowerCase();
        const match = q === '' || label.includes(q) || keys.includes(q);
        it.hidden = !match;
        if (match) anyVisible = true;
      });
      // Esconde grupos sem items visíveis
      groups.forEach((g) => {
        const algumVisivel = Array.from(g.querySelectorAll<HTMLElement>('.cmdk-item')).some((i) => !i.hidden);
        g.hidden = !algumVisivel;
      });
      emptyEl!.classList.toggle('hidden', anyVisible);
      activeIdx = 0;
      setActive(0);
    }

    function abrirComando(href: string) {
      fechar();
      if (href.startsWith('http')) {
        window.open(href, '_blank', 'noopener');
      } else {
        window.location.href = href;
      }
    }

    // Atalho global Cmd+K / Ctrl+K
    document.addEventListener('keydown', (e) => {
      const isMeta = e.metaKey || e.ctrlKey;
      if (isMeta && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog!.classList.contains('hidden')) abrir();
        else fechar();
      } else if (e.key === 'Escape' && !dialog!.classList.contains('hidden')) {
        e.preventDefault();
        fechar();
      }
    });

    // Backdrop clica = fecha
    backdrop.addEventListener('click', fechar);

    // Input
    input.addEventListener('input', () => filtrar(input.value));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(activeIdx + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(activeIdx - 1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const vis = visibleItems();
        const target = vis[activeIdx];
        if (target) abrirComando(target.dataset.cmdHref ?? '/');
      }
    });

    // Click direto em item
    items.forEach((it) => {
      it.addEventListener('click', () => abrirComando(it.dataset.cmdHref ?? '/'));
      it.addEventListener('mouseenter', () => {
        const vis = visibleItems();
        const idx = vis.indexOf(it);
        if (idx >= 0) setActive(idx);
      });
    });
  }
</script>

<style>
  /* aria-selected:bg-* funciona via Tailwind variant em modern Tailwind */
  [role="option"][aria-selected="true"] {
    /* fallback caso variant aria-selected nao esteja ativo no Tailwind 3 */
    background-color: rgb(44 121 230 / 0.15);
    color: white;
  }
</style>
