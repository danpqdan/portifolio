FLASK_ENV=production
FLASK_APP=app.py

# Configurações de segurança
SECRET_KEY=sua-chave-secreta-super-segura-aqui

# CORS para produção
CORS_ORIGINS=https://dsplayground.com.br,https://www.dsplayground.com.br

# InfluxDB
INFLUXDB_MODE=local
INFLUXDB_URL_LOCAL=http://127.0.0.1:8086
INFLUXDB_URL_REMOTE=http://dsplayground.com.br/influxdb
INFLUXDB_TOKEN=seu-token-influxdb-aqui
INFLUXDB_ORG=zen
INFLUXDB_BUCKET=portifolio
INFLUXDB_ENABLED=true

# Configurações temporais
TEMPORAL_REALTIME_INTERVAL=5000
TEMPORAL_REGULAR_INTERVAL=15000

# Servidor
HOST=127.0.0.1
PORT=5000