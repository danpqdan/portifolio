# Configuração do # Tamanho máximo do cache temporal (número de entradas)
TEMPORAL_CACHE_SIZE=1000

# Intervalo de limpeza do cache temporal (segundos)
TEMPORAL_CLEANUP_INTERVAL=300

# ==================== CONFIGURAÇÕES INFLUXDB ====================

# URL do servidor InfluxDB
INFLUXDB_URL=http://127.0.0.1:8086

# Token de autenticação InfluxDB
INFLUXDB_TOKEN=***REMOVED***

# Organização InfluxDB
INFLUXDB_ORG=zen

# Bucket para armazenar dados temporais
INFLUXDB_BUCKET=portifolio

# Habilitar/desabilitar InfluxDB
INFLUXDB_ENABLED=true
FLASK_ENV=development
FLASK_APP=app.py

# Chave secreta (altere em produção)
SECRET_KEY=dev-secret-key-change-in-production

# Configuração do CORS (URLs permitidas separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== CONFIGURAÇÕES DE COLETA TEMPORAL ====================

# Intervalo para envio temporal em tempo real (milissegundos)
TEMPORAL_REALTIME_INTERVAL=5000

# Intervalo para envio regular de dados (milissegundos)
TEMPORAL_REGULAR_INTERVAL=15000

# Tamanho máximo do cache temporal (número de entradas)
TEMPORAL_CACHE_SIZE=1000

# Intervalo de limpeza do cache (segundos)
TEMPORAL_CLEANUP_INTERVAL=300

# Porta da aplicação
PORT=5000

# Host da aplicação
HOST=0.0.0.0