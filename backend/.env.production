# Configuração de produção para OLS
FLASK_ENV=production
FLASK_APP=app.py
FLASK_DEBUG=False

# Segurança - ALTERE ESTAS CHAVES EM PRODUÇÃO!
SECRET_KEY=your-super-secret-key-change-this-min-32-characters-long

# CORS - URLs permitidas
CORS_ORIGINS=https://dsplayground.com.br,https://www.dsplayground.com.br,http://dsplayground.com.br,http://127.0.0.1:5173

# InfluxDB - Configurações
INFLUXDB_MODE=local
INFLUXDB_URL_LOCAL=http://127.0.0.1:8086
INFLUXDB_URL_REMOTE=http://dsplayground.com.br:8086
INFLUXDB_TOKEN=your-influxdb-token-here-replace-with-real-token
INFLUXDB_ORG=zen
INFLUXDB_BUCKET=portifolio
INFLUXDB_ENABLED=true

# Configurações do servidor
HOST=127.0.0.1
PORT=5000
WORKERS=4

# Rate Limiting e segurança
RATE_LIMIT_STORAGE_URL=memory://
SESSION_TIMEOUT=3600
MAX_REQUESTS_PER_MINUTE=100

# Configurações temporais (millisegundos)
TEMPORAL_REALTIME_INTERVAL=5000
TEMPORAL_REGULAR_INTERVAL=15000
TEMPORAL_CLEANUP_INTERVAL=300
TEMPORAL_CACHE_SIZE=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE=flask.log

# Proxy reverso (LiteSpeed)
APPLICATION_ROOT=/api
PREFERRED_URL_SCHEME=https
SESSION_COOKIE_SECURE=true